<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs"><node oor:name="TwoDriveAutoSave" oor:op="replace">
    <prop oor:name="Service"><value>org.twodrive.office.AutoSave</value></prop>
